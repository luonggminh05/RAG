# =================================================================
# Cấu hình Môi trường RAG Python AI Service
# =================================================================

# --- 1. LLM & Vision Endpoint (Ollama Docker hoặc vLLM / LM Studio) ---
UPRAG_LMSTUDIOENDPOINT=http://localhost:11434/v1
UPRAG_MODELID=qwen2.5:3b
UPRAG_APIKEY=ollama
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# --- 2. Vision API (Dùng cho OCR & Phân tích hình ảnh, bảng biểu trong tài liệu) ---
INGESTION_ENABLEVISIONCAPTION=true
INGESTION_VISIONAPIURL=http://localhost:11434/v1/chat/completions
INGESTION_VISIONMODEL=qwen2.5vl:7b
INGESTION_VISIONAPIKEY=ollama

# --- 3. Embedding Server (TEI - Text Embeddings Inference) ---
TEI_URL=http://localhost:8080
EMBEDDING_DIMS=1024
EMBEDDING_MODEL=BAAI/bge-m3

# --- 4. SQL Server Connection String ---
SQLSERVER_CONNECTIONSTRING=Server=localhost;Database=RagVectorDb;User Id=sa;Password=REPLACE_WITH_YOUR_SQL_SA_PASSWORD;TrustServerCertificate=True;

# --- 5. OCR Local Settings ---
INGESTION_ENABLEOCR=true
INGESTION_TESSDATAPATH=C:\Program Files\Tesseract-OCR\tessdata

# --- 6. Security API Key (Xác thực request nội bộ từ Gateway C#) ---
RAG_API_REQUIRED_API_KEY=

# --- 7. Reranker Settings (disabled / flashrank / cross_encoder) ---
RERANKER_TYPE=disabled
RERANKER_MODEL=BAAI/bge-reranker-base

# --- 8. RAG Dynamic Top-K Retrieval Settings ---
RAG_DYNAMIC_TOP_K_ENABLED=true
RAG_DYNAMIC_TOP_K_BASE=5
RAG_DYNAMIC_TOP_K_MIN=3
RAG_DYNAMIC_TOP_K_MAX=10
RAG_DYNAMIC_TOP_K_COMPLEX_BONUS=2
RAG_DYNAMIC_TOP_K_SIMPLE_DISCOUNT=1
RAG_DYNAMIC_TOP_K_LOW_CONF_BOOST=2
RAG_DYNAMIC_TOP_K_CONF_THRESHOLD=0.6

# --- 9. RAG Adjacent Chunk Context Expansion ---
RAG_ADJACENT_EXPANSION_ENABLED=true
RAG_ADJACENT_EXPANSION_WINDOW=1

# --- 10. Vietnamese Text Normalization Settings ---
RAG_ENABLE_VIETNAMESE_NORMALIZATION=true
RAG_NORMALIZATION_USE_SEGMENTATION=false

# --- 11. LLMOps & Observability (Langfuse) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
